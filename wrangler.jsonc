// Cloudflare Workers (static assets): https://prototype.dpy-mi.workers.dev
// The name must match the Worker in the dashboard, or GitHub deploys fail.
{
  "name": "prototype",
  "compatibility_date": "2026-10-01",
  // only /api/* runs code (the form sender); every other address is served straight from the files
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // unknown paths get the branded 404.html (with a real 404 status)
    "not_found_handling": "404-page"
  },
  // QUOTE_TO, SERVICE_TO and MAIL_FROM are set in the dashboard (RESEND_API_KEY as a secret), never here:
  // keep_vars stops a deploy from wiping them
  "keep_vars": true
}
